<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.floww-lock" path="/org/gnome/shell/extensions/floww-lock/">
    <!-- Wallpaper -->
    <key name="wallpaper-source" type="s">
      <choices><choice value="desktop"/><choice value="custom"/></choices>
      <default>'desktop'</default><summary>Use the desktop wallpaper or a separate lock screen image</summary>
    </key>
    <key name="wallpaper-path" type="s"><default>''</default><summary>Lock screen wallpaper image (when the source is custom)</summary></key>
    <key name="wallpaper-blur" type="i"><range min="0" max="100"/><default>12</default><summary>Wallpaper blur radius</summary></key>
    <key name="wallpaper-dim" type="i"><range min="0" max="80"/><default>12</default><summary>Wallpaper darkening, percent</summary></key>

    <!-- Clock -->
    <key name="clock-style" type="s">
      <choices><choice value="stacked"/><choice value="classic"/><choice value="split"/><choice value="minimal"/></choices>
      <default>'stacked'</default><summary>Clock arrangement</summary>
    </key>
    <key name="clock-position" type="s">
      <choices><choice value="top"/><choice value="center"/><choice value="top-left"/><choice value="top-right"/><choice value="bottom-left"/><choice value="bottom-right"/></choices>
      <default>'top'</default><summary>Where the clock sits</summary>
    </key>
    <key name="clock-format" type="s">
      <choices><choice value="system"/><choice value="12h"/><choice value="24h"/></choices>
      <default>'system'</default><summary>12 or 24 hour clock</summary>
    </key>
    <key name="clock-size" type="i"><range min="48" max="260"/><default>128</default><summary>Clock size in pixels</summary></key>
    <key name="clock-weight" type="i"><range min="100" max="900"/><default>600</default><summary>Clock font weight</summary></key>
    <key name="clock-opacity" type="i"><range min="30" max="100"/><default>88</default><summary>Clock opacity, percent</summary></key>
    <key name="font-family" type="s"><default>'SF Pro Display, Inter Display, Inter, Cantarell, sans-serif'</default><summary>Font for the clock and widgets</summary></key>

    <!-- Glass -->
    <key name="glass-tint" type="s"><default>'rgba(255,255,255,0.12)'</default><summary>Glass tint colour (with alpha)</summary></key>
    <key name="glass-blur" type="i"><range min="0" max="80"/><default>28</default><summary>How much the glass blurs what is behind it</summary></key>
    <key name="glass-refraction" type="i"><range min="0" max="100"/><default>55</default><summary>Edge refraction strength</summary></key>
    <key name="glass-radius" type="i"><range min="8" max="48"/><default>28</default><summary>Glass corner radius</summary></key>

    <!-- Layout -->
    <key name="widget-position" type="s">
      <choices><choice value="below-clock"/><choice value="left"/><choice value="right"/><choice value="bottom-left"/><choice value="bottom-right"/><choice value="hidden"/></choices>
      <default>'below-clock'</default><summary>Where the music widget sits</summary>
    </key>
    <key name="widget-lyrics" type="b"><default>true</default><summary>Show live lyrics in the music widget</summary></key>
    <key name="prompt-position" type="s">
      <choices><choice value="bottom"/><choice value="center"/></choices>
      <default>'bottom'</default><summary>Where the password prompt appears</summary>
    </key>

    <!-- Notifications -->
    <key name="notifications-mode" type="s">
      <choices><choice value="full"/><choice value="count"/><choice value="hidden"/></choices>
      <default>'full'</default><summary>Show notifications, only a count, or nothing</summary>
    </key>
    <key name="notifications-position" type="s">
      <choices><choice value="bottom"/><choice value="below-widget"/><choice value="right"/><choice value="left"/></choices>
      <default>'below-widget'</default><summary>Where notifications sit</summary>
    </key>
  </schema>
</schemalist>
